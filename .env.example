# --- Configuração do modelo de IA ---
# Chave de API do modelo.
OPENAI_API_KEY="sk-..."

# Endpoint de API do modelo. Informe o endereço compatível com o formato OpenAI fornecido pelo serviço; praticamente todos os modelos oferecem interface compatível.
# Consulte a documentação do modelo usado. Se o endpoint for https://xx.xx.com/v1/chat/completions, basta preencher a parte inicial em OPENAI_BASE_URL, por exemplo https://xx.xx.com/v1/
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Nome do modelo utilizado; o modelo precisa suportar upload de imagens.
OPENAI_MODEL_NAME="gemini-2.5-pro"

# (Opcional) Proxy HTTP/S para as requisições de IA. Suporta http e socks5. Ex.: http://127.0.0.1:7890 ou socks5://127.0.0.1:1080
PROXY_URL=""

# Configuração do serviço de notificações ntfy
NTFY_TOPIC_URL="https://ntfy.sh/your-topic-name" # Substitua pelo URL do seu tópico ntfy

# (Opcional) Configuração do serviço de notificações Gotify
# Endereço do seu serviço Gotify, ex.: https://push.example.de
# Token do seu app Gotify
GOTIFY_URL=""
GOTIFY_TOKEN=""

# (Opcional) Configuração do serviço Bark
# Endereço do seu push Bark, ex.: https://api.day.app/your_key
BARK_URL=""

# Configuração de notificação via robô do WeChat corporativo; deixe vazio se não usar.
WX_BOT_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx"

# Configuração de bot do Telegram; deixe vazio se não usar.
# Obter o Bot Token: converse com @BotFather para criar um novo bot
# Obter o Chat ID: converse com @userinfobot para pegar seu ID de usuário ou adicione o bot a um grupo e copie o ID do grupo
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# (Opcional) Configuração de webhook genérico
# Seu URL de webhook, ex.: https://foo.bar.com/quz?a=b
# Método da requisição: "GET" ou "POST"
# Cabeçalhos customizados (formato JSON)
# Tipo de conteúdo para POST: "JSON" ou "FORM"
# Parâmetros de query para GET (formato JSON; suporta placeholders {{title}} e {{content}})
# Corpo da requisição POST (formato JSON; suporta placeholders {{title}} e {{content}})
WEBHOOK_URL=""
WEBHOOK_METHOD="POST"
WEBHOOK_HEADERS='{"X-API-TOKEN":"your-secret-token"}'
WEBHOOK_CONTENT_TYPE="JSON"
WEBHOOK_QUERY_PARAMETERS='{"title":"{{title}}","content":"{{content}}"}'
WEBHOOK_BODY='{"title":"{{title}}","content":"{{content}}"}'

# Usar navegador Edge? Por padrão é usado o Chrome.
LOGIN_IS_EDGE=false

# Converter links de PC para links móveis.
PCURL_TO_MOBILE=true

# O crawler deve rodar em modo headless? (true/false)
# Para resolver captchas de arrastar localmente, defina como false para fazer a verificação manualmente; se houver risco de bloqueio, interrompa a execução.
# Em implantação via Docker não há suporte a GUI; defina RUN_HEADLESS=true, caso contrário não executará.
RUN_HEADLESS=true

# (Opcional) Modo de depuração da IA (true/false). Habilita logs adicionais no console para diagnosticar análises da IA.
AI_DEBUG_MODE=false

# Ativar o parâmetro enable_thinking? (true/false). Alguns modelos precisam dele, outros não suportam.
ENABLE_THINKING=false

# Ativar o parâmetro response_format? (true/false). Modelos como Doubao não suportam o formato json_object e exigem false. Outros, como Gemini, podem usar true.
ENABLE_RESPONSE_FORMAT=true

# Porta do servidor; se não definida, usa 8000 por padrão.
SERVER_PORT=8000

# Credenciais de autenticação para o serviço web
WEB_USERNAME=admin
WEB_PASSWORD=admin123
